{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ptt-website-2026",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true
  },
  // `npm run build` renders src/ + content/ into dist/; that folder is the site.
  "assets": {
    "directory": "dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
