{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ptt-website-2026",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true
  },
  // `npm run build` renders src/ + content/ into dist/; that folder is the site.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    // Single-page marketing site: navigation is all in-page (#hash) anchors, so
    // there are no real sub-paths. Serve index.html (HTTP 200) for any unmatched
    // URL instead of a hard 404. This keeps Google Ads / SEO crawlers off 404s
    // when a Final URL carries a tracking path, a stray trailing segment, or a
    // deep link. Real files (assets/, css/, js/, admin/) are still served directly.
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
